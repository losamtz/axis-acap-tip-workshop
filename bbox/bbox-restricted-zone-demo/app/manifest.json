{
    "schemaVersion": "2.0.0",
    "resources": {
        "dbus": {
            "requiredMethods": [
                "com.axis.Graphics2.*",
                "com.axis.Overlay2.*"
            ]
        },
        "linux": {
            "user": {
                "groups": [
                    "video",
                    "admin"
                ]
            }
        }
    },
    "acapPackageConf": {
        "setup": {
            "friendlyName": "BBox Restricted Zone Demo",
            "appName": "bbox_restricted_zone",
            "vendor": "Axis Communications",
            "vendorId": "1234567890",
            "vendorUrl": "https://www.axis.com",
            "runMode": "never",
            "version": "1.0.0",
            "compatibleOsVersions": [
                {
                    "max": "13"
                }
            ]
        },
        "configuration": {
            "settingPage": "index.html",
            "httpConfig": [
                {
                    "access": "admin",
                    "name": "status.cgi",
                    "type": "fastCgi"
                }
            ],
            "paramConfig": [
                {
                    "name": "Enabled",
                    "default": "yes",
                    "type": "bool"
                },
                {
                    "name": "Zone",
                    "default": "35,25,30,50",
                    "type": "string:maxlen=20"
                },
                {
                    "name": "Rule",
                    "default": "center",
                    "type": "enum:center,overlap"
                },
                {
                    "name": "DwellSeconds",
                    "default": "3",
                    "type": "int:min=1;max=60"
                }
            ]
        }
    }
}
