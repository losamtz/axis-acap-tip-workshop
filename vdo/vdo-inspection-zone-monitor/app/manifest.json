{
    "schemaVersion": "2.0.0",
    "resources": {
        "linux": {
            "user": {
                "groups": [
                    "video",
                    "admin"
                ]
            }
        }
    },
    "acapPackageConf": {
        "setup": {
            "friendlyName": "VDO Inspection Zone Monitor",
            "appName": "vdo_inspection_zone",
            "vendor": "Axis Communications",
            "vendorId": "1234567890",
            "vendorUrl": "https://www.axis.com",
            "runMode": "never",
            "version": "1.0.0",
            "compatibleOsVersions": [
                {
                    "max": "13"
                }
            ]
        },
        "configuration": {
            "paramConfig": [
                {
                    "name": "Enabled",
                    "default": "yes",
                    "type": "bool"
                },
                {
                    "name": "Zone",
                    "default": "20,20,60,60",
                    "type": "string:maxlen=20"
                },
                {
                    "name": "PixelDelta",
                    "default": "25",
                    "type": "int:min=1;max=255"
                },
                {
                    "name": "OccupiedPercent",
                    "default": "10",
                    "type": "int:min=1;max=100"
                },
                {
                    "name": "DwellSeconds",
                    "default": "10",
                    "type": "int:min=1;max=3600"
                }
            ],
            "settingPage": "index.html",
            "httpConfig": [
                {
                    "access": "admin",
                    "name": "status.cgi",
                    "type": "fastCgi"
                },
                {
                    "access": "admin",
                    "name": "calibrate.cgi",
                    "type": "fastCgi"
                }
            ]
        }
    }
}
